# ═══════════════════════════════════════════════════════════════
#  CoupleSync Environment Variables
# ═══════════════════════════════════════════════════════════════
#
#  PRIORITY ORDER (app picks first available):
#  1. Redis (Upstash) — fastest, scales to 10k+ concurrent users
#  2. Supabase         — good, uses Postgres + realtime
#  3. Local/Demo       — no backend, works offline
#
# ───────────────────────────────────────────────────────────────
#  OPTION 1: Upstash Redis (FREE tier: 10k req/day)
#  Sign up at https://upstash.com → Create Redis database
#  Copy REST URL and REST Token from the dashboard
# ───────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# ───────────────────────────────────────────────────────────────
#  OPTION 2: Supabase (FREE tier: 500MB, unlimited realtime)
#  Sign up at https://supabase.com → New project
#  Run schema.sql in SQL Editor, copy URL + anon key
# ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
