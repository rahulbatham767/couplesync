[
  { "id": 0, "text": "Your ideal Saturday morning together?", "emoji": "🌅", "options": [{"id":"a","text":"Still in bed, breakfast ordered in","value":1},{"id":"b","text":"Farmers market then brunch","value":2},{"id":"c","text":"Morning hike to catch sunrise","value":3},{"id":"d","text":"Each doing our own thing, then meeting up","value":4}] },
  { "id": 1, "text": "Dream vacation style?", "emoji": "✈️", "options": [{"id":"a","text":"Luxury resort, total relaxation","value":1},{"id":"b","text":"Cultural immersion, hidden gems","value":2},{"id":"c","text":"Adventure sports, thrill-seeking","value":3},{"id":"d","text":"Road trip, spontaneous detours","value":4}] },
  { "id": 2, "text": "How do you handle conflict?", "emoji": "💬", "options": [{"id":"a","text":"Talk it out immediately, no waiting","value":1},{"id":"b","text":"Need space first, then discuss calmly","value":2},{"id":"c","text":"Write it out, then share feelings","value":3},{"id":"d","text":"Distract, then revisit when calm","value":4}] },
  { "id": 3, "text": "Love language that resonates most?", "emoji": "💝", "options": [{"id":"a","text":"Words of affirmation — tell me you love me","value":1},{"id":"b","text":"Quality time — present, phone away","value":2},{"id":"c","text":"Physical touch — hand-holding, cuddles","value":3},{"id":"d","text":"Acts of service — doing things without asking","value":4}] },
  { "id": 4, "text": "Five years from now, you envision...", "emoji": "🔮", "options": [{"id":"a","text":"Cozy home, maybe a pet or two","value":1},{"id":"b","text":"Traveling the world together","value":2},{"id":"c","text":"Building something creative together","value":3},{"id":"d","text":"Growing a family, roots in a community","value":4}] },
  { "id": 5, "text": "Your ideal Friday night in?", "emoji": "🌙", "options": [{"id":"a","text":"Movie marathon under a blanket","value":1},{"id":"b","text":"Cooking a fancy dinner together","value":2},{"id":"c","text":"Game night with friends","value":3},{"id":"d","text":"Each doing hobbies, same room","value":4}] },
  { "id": 6, "text": "Biggest green flag in a partner?", "emoji": "🚩", "options": [{"id":"a","text":"They remember small details about me","value":1},{"id":"b","text":"They push me to be better","value":2},{"id":"c","text":"They make me laugh every day","value":3},{"id":"d","text":"They give me space when I need it","value":4}] },
  { "id": 7, "text": "How do you feel about spontaneous plans?", "emoji": "⚡", "options": [{"id":"a","text":"Love them — life is more exciting","value":1},{"id":"b","text":"Okay sometimes, but I like notice","value":2},{"id":"c","text":"Rarely — I prefer a plan","value":3},{"id":"d","text":"Only if it's low-key and easy","value":4}] },
  { "id": 8, "text": "Money management as a couple?", "emoji": "💰", "options": [{"id":"a","text":"Fully joint — one pot, one plan","value":1},{"id":"b","text":"Split bills, save separately","value":2},{"id":"c","text":"Mostly joint with personal spending money","value":3},{"id":"d","text":"Fully separate — discuss big purchases only","value":4}] },
  { "id": 9, "text": "How important is alone time to you?", "emoji": "🧘", "options": [{"id":"a","text":"I recharge alone — it's essential","value":1},{"id":"b","text":"Nice occasionally, not a must","value":2},{"id":"c","text":"I prefer being together most of the time","value":3},{"id":"d","text":"Depends on the week","value":4}] },
  { "id": 10, "text": "Your communication style under stress?", "emoji": "🌪️", "options": [{"id":"a","text":"I go quiet and need time","value":1},{"id":"b","text":"I talk it through immediately","value":2},{"id":"c","text":"I get frustrated then apologise","value":3},{"id":"d","text":"I distract myself then circle back","value":4}] },
  { "id": 11, "text": "Ideal living situation?", "emoji": "🏠", "options": [{"id":"a","text":"City apartment, walking distance to everything","value":1},{"id":"b","text":"Suburb with space and a garden","value":2},{"id":"c","text":"Rural retreat, nature and quiet","value":3},{"id":"d","text":"Wherever life takes us","value":4}] },
  { "id": 12, "text": "How do you show care daily?", "emoji": "🤍", "options": [{"id":"a","text":"Random texts checking in","value":1},{"id":"b","text":"Making coffee or doing their chores","value":2},{"id":"c","text":"Saying it out loud often","value":3},{"id":"d","text":"Physical closeness — hugs, touch","value":4}] },
  { "id": 13, "text": "Social life as a couple?", "emoji": "🎉", "options": [{"id":"a","text":"We share the same friend group","value":1},{"id":"b","text":"Separate friends, occasional overlap","value":2},{"id":"c","text":"Mix of both — some shared, some separate","value":3},{"id":"d","text":"We mostly just prefer each other","value":4}] },
  { "id": 14, "text": "What does commitment mean to you?", "emoji": "💍", "options": [{"id":"a","text":"Choosing each other daily, consciously","value":1},{"id":"b","text":"Building a shared future together","value":2},{"id":"c","text":"Absolute loyalty and trust","value":3},{"id":"d","text":"Being each other's safe place","value":4}] },
  { "id": 15, "text": "Your biggest relationship deal-breaker?", "emoji": "⛔", "options": [{"id":"a","text":"Dishonesty in any form","value":1},{"id":"b","text":"Lack of ambition or drive","value":2},{"id":"c","text":"Emotional unavailability","value":3},{"id":"d","text":"Disrespecting my boundaries","value":4}] },
  { "id": 16, "text": "How do you apologise?", "emoji": "🌸", "options": [{"id":"a","text":"Say it directly and mean it","value":1},{"id":"b","text":"Actions speak — I do something nice","value":2},{"id":"c","text":"Need time to reflect, then apologise","value":3},{"id":"d","text":"Explain my side first, then apologise","value":4}] },
  { "id": 17, "text": "What is your love style?", "emoji": "❤️", "options": [{"id":"a","text":"Deeply romantic and expressive","value":1},{"id":"b","text":"Practical and steady","value":2},{"id":"c","text":"Playful and light","value":3},{"id":"d","text":"Intense and passionate","value":4}] },
  { "id": 18, "text": "Career vs. relationship — how do you balance?", "emoji": "⚖️", "options": [{"id":"a","text":"Relationship always comes first","value":1},{"id":"b","text":"Career is important, but so is us","value":2},{"id":"c","text":"Both equally, with honest communication","value":3},{"id":"d","text":"My partner supports my ambition fully","value":4}] },
  { "id": 19, "text": "Ideal date night?", "emoji": "🕯️", "options": [{"id":"a","text":"Fine dining and a long walk home","value":1},{"id":"b","text":"Cooking together with good wine","value":2},{"id":"c","text":"Concert, show, or live event","value":3},{"id":"d","text":"Spontaneous — wherever the night goes","value":4}] },
  { "id": 20, "text": "How do you handle jealousy?", "emoji": "👀", "options": [{"id":"a","text":"Talk about it openly and quickly","value":1},{"id":"b","text":"Work through it alone first","value":2},{"id":"c","text":"I rarely feel it — I trust easily","value":3},{"id":"d","text":"Acknowledge it but don't act on it","value":4}] },
  { "id": 21, "text": "Your sleep schedule?", "emoji": "😴", "options": [{"id":"a","text":"Early to bed, early to rise","value":1},{"id":"b","text":"Night owl, late mornings","value":2},{"id":"c","text":"Flexible, adapts to partner","value":3},{"id":"d","text":"All over the place honestly","value":4}] },
  { "id": 22, "text": "Kids in your future?", "emoji": "👶", "options": [{"id":"a","text":"Definitely yes, high priority","value":1},{"id":"b","text":"Open to it, not a dealbreaker","value":2},{"id":"c","text":"Leaning no, but flexible","value":3},{"id":"d","text":"Definitely no","value":4}] },
  { "id": 23, "text": "How important is shared religion or spirituality?", "emoji": "🙏", "options": [{"id":"a","text":"Very — it's core to who I am","value":1},{"id":"b","text":"Somewhat — I'd like alignment","value":2},{"id":"c","text":"Not very — live and let live","value":3},{"id":"d","text":"Not at all","value":4}] },
  { "id": 24, "text": "Biggest turn-on (personality)?", "emoji": "✨", "options": [{"id":"a","text":"Wit and intelligence","value":1},{"id":"b","text":"Confidence and decisiveness","value":2},{"id":"c","text":"Warmth and emotional depth","value":3},{"id":"d","text":"Ambition and drive","value":4}] },
  { "id": 25, "text": "How do you feel about pets?", "emoji": "🐾", "options": [{"id":"a","text":"Essential — I can't live without them","value":1},{"id":"b","text":"Love them, not a dealbreaker","value":2},{"id":"c","text":"Neutral — partner decides","value":3},{"id":"d","text":"Prefer no pets","value":4}] },
  { "id": 26, "text": "Your relationship with family?", "emoji": "👨‍👩‍👧", "options": [{"id":"a","text":"Very close — family is everything","value":1},{"id":"b","text":"Close but boundaries are important","value":2},{"id":"c","text":"Politely distant","value":3},{"id":"d","text":"Complicated, I keep them separate","value":4}] },
  { "id": 27, "text": "How often do you need reassurance?", "emoji": "🫂", "options": [{"id":"a","text":"Regularly — it fills my cup","value":1},{"id":"b","text":"Sometimes, especially in tough times","value":2},{"id":"c","text":"Rarely — I'm fairly secure","value":3},{"id":"d","text":"Almost never","value":4}] },
  { "id": 28, "text": "What's your relationship with social media?", "emoji": "📱", "options": [{"id":"a","text":"Very active — I post a lot","value":1},{"id":"b","text":"Moderate — I browse but rarely post","value":2},{"id":"c","text":"Minimal — only for close friends","value":3},{"id":"d","text":"Off the grid mostly","value":4}] },
  { "id": 29, "text": "How would your partner describe you?", "emoji": "🪞", "options": [{"id":"a","text":"Loyal and dependable","value":1},{"id":"b","text":"Fun and spontaneous","value":2},{"id":"c","text":"Deep and thoughtful","value":3},{"id":"d","text":"Driven and ambitious","value":4}] },
  { "id": 30, "text": "Favourite way to spend a Sunday?", "emoji": "☀️", "options": [{"id":"a","text":"Lazy brunch, nowhere to be","value":1},{"id":"b","text":"Exploring somewhere new","value":2},{"id":"c","text":"Gym, errands, meal prep","value":3},{"id":"d","text":"Nature walk or outdoor activity","value":4}] },
  { "id": 31, "text": "How do you feel about couple photos/posts?", "emoji": "📸", "options": [{"id":"a","text":"Love them — document everything","value":1},{"id":"b","text":"Occasional is nice","value":2},{"id":"c","text":"Keep it mostly private","value":3},{"id":"d","text":"Strongly prefer privacy","value":4}] },
  { "id": 32, "text": "What does a perfect home feel like?", "emoji": "🕊️", "options": [{"id":"a","text":"Warm, cosy, maximalist","value":1},{"id":"b","text":"Clean, minimal, calm","value":2},{"id":"c","text":"Lived-in and creative","value":3},{"id":"d","text":"Functional first, beautiful second","value":4}] },
  { "id": 33, "text": "Your exercise and health habits?", "emoji": "🏋️", "options": [{"id":"a","text":"Very active — it's a lifestyle","value":1},{"id":"b","text":"Regular but flexible","value":2},{"id":"c","text":"Occasional — when motivated","value":3},{"id":"d","text":"Not a priority right now","value":4}] },
  { "id": 34, "text": "What makes you feel most loved?", "emoji": "💌", "options": [{"id":"a","text":"Heartfelt words and compliments","value":1},{"id":"b","text":"Undivided time and attention","value":2},{"id":"c","text":"Small thoughtful gestures","value":3},{"id":"d","text":"Physical affection","value":4}] },
  { "id": 35, "text": "How do you approach big decisions?", "emoji": "🗺️", "options": [{"id":"a","text":"Research everything, decide slowly","value":1},{"id":"b","text":"Gut feeling, decide quickly","value":2},{"id":"c","text":"Talk it through with partner","value":3},{"id":"d","text":"Make a pros/cons list","value":4}] },
  { "id": 36, "text": "Your relationship with food?", "emoji": "🍽️", "options": [{"id":"a","text":"Foodie — eat out often, try everything","value":1},{"id":"b","text":"Cook at home, eating out is a treat","value":2},{"id":"c","text":"Eat to live, not live to eat","value":3},{"id":"d","text":"Healthy eating is a priority","value":4}] },
  { "id": 37, "text": "How do you handle long distance (if ever needed)?", "emoji": "📡", "options": [{"id":"a","text":"It's hard but I'd make it work","value":1},{"id":"b","text":"Short term only — months max","value":2},{"id":"c","text":"Dealbreaker for me","value":3},{"id":"d","text":"I'd adapt to whatever's needed","value":4}] },
  { "id": 38, "text": "What's your drinking/party culture?", "emoji": "🥂", "options": [{"id":"a","text":"Love a good night out regularly","value":1},{"id":"b","text":"Occasionally, not a lifestyle","value":2},{"id":"c","text":"Rarely — not my scene","value":3},{"id":"d","text":"Sober or almost","value":4}] },
  { "id": 39, "text": "How do you feel about couples therapy?", "emoji": "🛋️", "options": [{"id":"a","text":"Proactively — before problems arise","value":1},{"id":"b","text":"Open to it if things get hard","value":2},{"id":"c","text":"Last resort only","value":3},{"id":"d","text":"I'd rather handle things ourselves","value":4}] },
  { "id": 40, "text": "Biggest source of relationship conflict for you?", "emoji": "⚡", "options": [{"id":"a","text":"Different priorities or values","value":1},{"id":"b","text":"Communication breakdown","value":2},{"id":"c","text":"Lack of quality time","value":3},{"id":"d","text":"External stress bleeding in","value":4}] },
  { "id": 41, "text": "How do you feel about surprises?", "emoji": "🎁", "options": [{"id":"a","text":"Love them — the bigger the better","value":1},{"id":"b","text":"Sweet ones yes, big ones no","value":2},{"id":"c","text":"Give me a heads-up please","value":3},{"id":"d","text":"Not a fan — I like to be prepared","value":4}] },
  { "id": 42, "text": "Your relationship with money?", "emoji": "💳", "options": [{"id":"a","text":"Saver — security is everything","value":1},{"id":"b","text":"Balanced — save and enjoy","value":2},{"id":"c","text":"Spender — experiences over savings","value":3},{"id":"d","text":"Investor — always building","value":4}] },
  { "id": 43, "text": "Preferred way to argue?", "emoji": "🗣️", "options": [{"id":"a","text":"In the moment, resolve fast","value":1},{"id":"b","text":"Take a break, come back calm","value":2},{"id":"c","text":"Write it down first","value":3},{"id":"d","text":"Avoid arguments if possible","value":4}] },
  { "id": 44, "text": "How do you feel about your partner's exes?", "emoji": "👻", "options": [{"id":"a","text":"Past is past — no issue","value":1},{"id":"b","text":"Fine as long as they're not close","value":2},{"id":"c","text":"I'd prefer minimal contact","value":3},{"id":"d","text":"Active friendship with exes is a no","value":4}] },
  { "id": 45, "text": "What's your ambition level?", "emoji": "🚀", "options": [{"id":"a","text":"Sky's the limit — always climbing","value":1},{"id":"b","text":"Ambitious in what matters to me","value":2},{"id":"c","text":"Comfortable and content is enough","value":3},{"id":"d","text":"Still figuring it out","value":4}] },
  { "id": 46, "text": "Holidays — how do you like to spend them?", "emoji": "🎄", "options": [{"id":"a","text":"With family — it's tradition","value":1},{"id":"b","text":"Just the two of us","value":2},{"id":"c","text":"Travel somewhere new","value":3},{"id":"d","text":"Low-key, no pressure","value":4}] },
  { "id": 47, "text": "What's your creative outlet?", "emoji": "🎨", "options": [{"id":"a","text":"Music, art, or writing","value":1},{"id":"b","text":"Cooking or gardening","value":2},{"id":"c","text":"Photography or film","value":3},{"id":"d","text":"I'm not particularly creative","value":4}] },
  { "id": 48, "text": "Your morning routine?", "emoji": "☕", "options": [{"id":"a","text":"Slow and sacred — don't rush me","value":1},{"id":"b","text":"Efficient — shower, go","value":2},{"id":"c","text":"Workout first, then ready","value":3},{"id":"d","text":"Chaos — always running late","value":4}] },
  { "id": 49, "text": "Most important thing in a long-term partner?", "emoji": "🏆", "options": [{"id":"a","text":"Deep emotional connection","value":1},{"id":"b","text":"Shared values and goals","value":2},{"id":"c","text":"Attraction and chemistry","value":3},{"id":"d","text":"Making each other better people","value":4}] },
  { "id": 50, "text": "How do you feel about gender roles?", "emoji": "⚧️", "options": [{"id":"a","text":"Equal everything — 50/50","value":1},{"id":"b","text":"Play to each other's strengths","value":2},{"id":"c","text":"Some traditional elements are fine","value":3},{"id":"d","text":"Traditional roles work for us","value":4}] },
  { "id": 51, "text": "Your relationship with travel?", "emoji": "🌍", "options": [{"id":"a","text":"Always travelling — it's a lifestyle","value":1},{"id":"b","text":"A few trips a year is ideal","value":2},{"id":"c","text":"One big trip annually","value":3},{"id":"d","text":"Happy at home mostly","value":4}] },
  { "id": 52, "text": "Favourite type of movie to watch together?", "emoji": "🎬", "options": [{"id":"a","text":"Rom-coms and feel-good films","value":1},{"id":"b","text":"Thriller or mystery","value":2},{"id":"c","text":"Documentary or arthouse","value":3},{"id":"d","text":"Action or sci-fi","value":4}] },
  { "id": 53, "text": "How do you feel about working from home?", "emoji": "💻", "options": [{"id":"a","text":"Love it — flexibility is key","value":1},{"id":"b","text":"Mix of home and office is ideal","value":2},{"id":"c","text":"Office is better — separation is healthy","value":3},{"id":"d","text":"Don't mind either way","value":4}] },
  { "id": 54, "text": "How tidy do you keep shared spaces?", "emoji": "🧹", "options": [{"id":"a","text":"Very tidy — mess stresses me out","value":1},{"id":"b","text":"Generally tidy with lived-in areas","value":2},{"id":"c","text":"Comfortably messy","value":3},{"id":"d","text":"Organised chaos — I know where things are","value":4}] },
  { "id": 55, "text": "How do you handle different music tastes?", "emoji": "🎵", "options": [{"id":"a","text":"Find common ground and share playlists","value":1},{"id":"b","text":"Take turns playing what we like","value":2},{"id":"c","text":"Headphones are fine for differences","value":3},{"id":"d","text":"Music compatibility is important to me","value":4}] },
  { "id": 56, "text": "What excites you most about the future?", "emoji": "🌠", "options": [{"id":"a","text":"Building a home and family","value":1},{"id":"b","text":"Adventures and experiences","value":2},{"id":"c","text":"Career and personal growth","value":3},{"id":"d","text":"Financial freedom and security","value":4}] },
  { "id": 57, "text": "How do you feel when your partner is upset?", "emoji": "😔", "options": [{"id":"a","text":"I need to fix it immediately","value":1},{"id":"b","text":"I hold space and listen","value":2},{"id":"c","text":"I give them space and check in later","value":3},{"id":"d","text":"I struggle — it affects me too","value":4}] },
  { "id": 58, "text": "How important is intellectual connection?", "emoji": "🧠", "options": [{"id":"a","text":"Essential — we need to challenge each other","value":1},{"id":"b","text":"Important but not the only thing","value":2},{"id":"c","text":"Nice to have, not a dealbreaker","value":3},{"id":"d","text":"Not a priority — heart over head","value":4}] },
  { "id": 59, "text": "Your attitude to personal growth?", "emoji": "🌱", "options": [{"id":"a","text":"Constantly working on myself","value":1},{"id":"b","text":"Growing when life demands it","value":2},{"id":"c","text":"Content as I am","value":3},{"id":"d","text":"I grow through my relationships","value":4}] },
  { "id": 60, "text": "How do you prefer to receive criticism?", "emoji": "🎯", "options": [{"id":"a","text":"Direct and honest — no sugar-coating","value":1},{"id":"b","text":"Gently with context","value":2},{"id":"c","text":"Written so I can process it","value":3},{"id":"d","text":"Through actions not words","value":4}] },
  { "id": 61, "text": "How do you feel about public displays of affection?", "emoji": "💏", "options": [{"id":"a","text":"Love it — show the world","value":1},{"id":"b","text":"Subtle affection is fine","value":2},{"id":"c","text":"Keep it very private","value":3},{"id":"d","text":"Depends on context","value":4}] },
  { "id": 62, "text": "Your ideal relationship pace?", "emoji": "⏳", "options": [{"id":"a","text":"Slow burn — build trust first","value":1},{"id":"b","text":"Medium — natural progression","value":2},{"id":"c","text":"Fast when it's right","value":3},{"id":"d","text":"No rules — just feel it out","value":4}] },
  { "id": 63, "text": "What annoys you most day-to-day?", "emoji": "😤", "options": [{"id":"a","text":"Lateness and poor time management","value":1},{"id":"b","text":"Leaving things unfinished","value":2},{"id":"c","text":"Being ignored or dismissed","value":3},{"id":"d","text":"Lack of communication","value":4}] },
  { "id": 64, "text": "How do you feel about big age gaps in couples?", "emoji": "🗓️", "options": [{"id":"a","text":"Age is just a number","value":1},{"id":"b","text":"Depends on the people involved","value":2},{"id":"c","text":"Prefer similar life stages","value":3},{"id":"d","text":"Close in age is important to me","value":4}] },
  { "id": 65, "text": "What's your definition of trust?", "emoji": "🔐", "options": [{"id":"a","text":"Knowing they'll never intentionally hurt me","value":1},{"id":"b","text":"Total honesty even when hard","value":2},{"id":"c","text":"Showing up consistently over time","value":3},{"id":"d","text":"Respecting my privacy and space","value":4}] },
  { "id": 66, "text": "Your ideal holiday destination?", "emoji": "🏝️", "options": [{"id":"a","text":"Tropical beach, zero plans","value":1},{"id":"b","text":"European city — culture and food","value":2},{"id":"c","text":"Mountains and hiking","value":3},{"id":"d","text":"Somewhere off the beaten path","value":4}] },
  { "id": 67, "text": "How do you handle it when a partner needs more space?", "emoji": "🌬️", "options": [{"id":"a","text":"Respect it fully and trust the process","value":1},{"id":"b","text":"Give it, but need reassurance","value":2},{"id":"c","text":"Hard for me — I overthink it","value":3},{"id":"d","text":"Check in periodically","value":4}] },
  { "id": 68, "text": "How would you describe your attachment style?", "emoji": "🪢", "options": [{"id":"a","text":"Secure — I trust and feel trusted","value":1},{"id":"b","text":"Anxious — I need regular connection","value":2},{"id":"c","text":"Avoidant — I need autonomy","value":3},{"id":"d","text":"Still figuring it out","value":4}] },
  { "id": 69, "text": "What role does humour play in your relationship?", "emoji": "😂", "options": [{"id":"a","text":"Central — must be able to be silly together","value":1},{"id":"b","text":"Important but not the foundation","value":2},{"id":"c","text":"Nice but not a priority","value":3},{"id":"d","text":"I take relationships seriously","value":4}] },
  { "id": 70, "text": "How often do you want to travel internationally?", "emoji": "🛫", "options": [{"id":"a","text":"Multiple times a year","value":1},{"id":"b","text":"Once a year is ideal","value":2},{"id":"c","text":"Every few years","value":3},{"id":"d","text":"Rarely — prefer local","value":4}] },
  { "id": 71, "text": "How important is physical attraction long-term?", "emoji": "🔥", "options": [{"id":"a","text":"Very — it has to stay strong","value":1},{"id":"b","text":"Important but deepens with love","value":2},{"id":"c","text":"Emotional bond matters more","value":3},{"id":"d","text":"It evolves and that's okay","value":4}] },
  { "id": 72, "text": "What's your weekend morning ritual?", "emoji": "🥐", "options": [{"id":"a","text":"Lie-in as long as possible","value":1},{"id":"b","text":"Coffee and reading or podcast","value":2},{"id":"c","text":"Workout first thing","value":3},{"id":"d","text":"Up early, get things done","value":4}] },
  { "id": 73, "text": "How do you feel about your partner having close opposite-sex friends?", "emoji": "🤝", "options": [{"id":"a","text":"Completely fine — I trust them fully","value":1},{"id":"b","text":"Fine with transparency","value":2},{"id":"c","text":"Depends on the friendship","value":3},{"id":"d","text":"Prefer they keep it distant","value":4}] },
  { "id": 74, "text": "What's your screen time like?", "emoji": "📺", "options": [{"id":"a","text":"High — work and leisure","value":1},{"id":"b","text":"Moderate — intentional use","value":2},{"id":"c","text":"Low — I prefer real life","value":3},{"id":"d","text":"Phone-free zones are important to me","value":4}] },
  { "id": 75, "text": "How do you show up for a struggling partner?", "emoji": "🫶", "options": [{"id":"a","text":"Problem-solve and find solutions","value":1},{"id":"b","text":"Listen without trying to fix","value":2},{"id":"c","text":"Physical comfort — just be there","value":3},{"id":"d","text":"Give them space but signal I'm here","value":4}] },
  { "id": 76, "text": "What's your relationship with your own emotions?", "emoji": "🌊", "options": [{"id":"a","text":"Very in touch — I feel deeply","value":1},{"id":"b","text":"Aware but controlled","value":2},{"id":"c","text":"Still learning to open up","value":3},{"id":"d","text":"Logical first, emotional second","value":4}] },
  { "id": 77, "text": "How do you feel about a partner reading your messages?", "emoji": "🔓", "options": [{"id":"a","text":"Totally fine — nothing to hide","value":1},{"id":"b","text":"Fine if asked, not without asking","value":2},{"id":"c","text":"My phone is private always","value":3},{"id":"d","text":"Would depend on context","value":4}] },
  { "id": 78, "text": "Your ideal number of kids?", "emoji": "👨‍👩‍👦‍👦", "options": [{"id":"a","text":"One or two","value":1},{"id":"b","text":"Three or more","value":2},{"id":"c","text":"Zero","value":3},{"id":"d","text":"Haven't decided yet","value":4}] },
  { "id": 79, "text": "How do you feel about your partner's friends disliking you?", "emoji": "😬", "options": [{"id":"a","text":"I'd work hard to win them over","value":1},{"id":"b","text":"I'd respect the distance but stay open","value":2},{"id":"c","text":"My partner's opinion is what matters","value":3},{"id":"d","text":"It would genuinely bother me","value":4}] },
  { "id": 80, "text": "Your idea of romance?", "emoji": "🌹", "options": [{"id":"a","text":"Grand gestures — go big or go home","value":1},{"id":"b","text":"Consistent small acts of love","value":2},{"id":"c","text":"Undivided attention and presence","value":3},{"id":"d","text":"Creating memories together","value":4}] },
  { "id": 81, "text": "How do you deal with uncertainty in life?", "emoji": "🎲", "options": [{"id":"a","text":"Embrace it — it's exciting","value":1},{"id":"b","text":"Plan as much as possible","value":2},{"id":"c","text":"Take it one day at a time","value":3},{"id":"d","text":"Rely on my partner for grounding","value":4}] },
  { "id": 82, "text": "How often do you need verbal affirmation?", "emoji": "🗣️", "options": [{"id":"a","text":"Daily — say it often","value":1},{"id":"b","text":"Regularly but not obsessively","value":2},{"id":"c","text":"Occasionally is enough","value":3},{"id":"d","text":"Actions mean more than words","value":4}] },
  { "id": 83, "text": "Your relationship with your past?", "emoji": "⏪", "options": [{"id":"a","text":"Healed and moved on","value":1},{"id":"b","text":"Still processing some things","value":2},{"id":"c","text":"It shaped me but doesn't define me","value":3},{"id":"d","text":"I keep it private mostly","value":4}] },
  { "id": 84, "text": "What kind of support do you need most?", "emoji": "🤲", "options": [{"id":"a","text":"Emotional — listen and validate me","value":1},{"id":"b","text":"Practical — help me solve it","value":2},{"id":"c","text":"Space — let me process alone","value":3},{"id":"d","text":"Physical presence — just be with me","value":4}] },
  { "id": 85, "text": "How do you feel about a partner who earns more than you?", "emoji": "📊", "options": [{"id":"a","text":"No issue at all — money is shared","value":1},{"id":"b","text":"Fine as long as we're equal in other ways","value":2},{"id":"c","text":"Slightly uncomfortable — I want to contribute equally","value":3},{"id":"d","text":"Very uncomfortable","value":4}] },
  { "id": 86, "text": "What's your relationship to personal space at home?", "emoji": "🚪", "options": [{"id":"a","text":"Need my own room or corner","value":1},{"id":"b","text":"Like my own time but share most spaces","value":2},{"id":"c","text":"Love being in the same room together","value":3},{"id":"d","text":"Wherever they are is home","value":4}] },
  { "id": 87, "text": "How do you feel about your partner's past relationships?", "emoji": "📖", "options": [{"id":"a","text":"Curious — it helps me understand them","value":1},{"id":"b","text":"Want the broad strokes, not details","value":2},{"id":"c","text":"Prefer not to discuss it","value":3},{"id":"d","text":"Completely irrelevant to me","value":4}] },
  { "id": 88, "text": "How important is it to share hobbies?", "emoji": "🎯", "options": [{"id":"a","text":"Very — I want us to do things together","value":1},{"id":"b","text":"A few shared, some separate is ideal","value":2},{"id":"c","text":"Independent hobbies are healthy","value":3},{"id":"d","text":"Not important — I have my world, they have theirs","value":4}] },
  { "id": 89, "text": "How would you handle a long rough patch?", "emoji": "🌧️", "options": [{"id":"a","text":"Fight for us — get help if needed","value":1},{"id":"b","text":"Have an honest conversation about the future","value":2},{"id":"c","text":"Give it time and space","value":3},{"id":"d","text":"Know when to walk away if it's not working","value":4}] },
  { "id": 90, "text": "How do you feel about your partner's career ambitions?", "emoji": "🏅", "options": [{"id":"a","text":"I'm their biggest cheerleader","value":1},{"id":"b","text":"Supportive as long as it doesn't consume them","value":2},{"id":"c","text":"Their career is their business","value":3},{"id":"d","text":"We should prioritise the same things","value":4}] },
  { "id": 91, "text": "What does a healthy argument look like to you?", "emoji": "🕊️", "options": [{"id":"a","text":"Short, resolved, no lingering resentment","value":1},{"id":"b","text":"Both feel heard even if unresolved","value":2},{"id":"c","text":"No raised voices, ever","value":3},{"id":"d","text":"Productive — we always learn something","value":4}] },
  { "id": 92, "text": "How do you feel about moving for a partner?", "emoji": "📦", "options": [{"id":"a","text":"Would do it if the relationship was right","value":1},{"id":"b","text":"Open to it with enough notice","value":2},{"id":"c","text":"Very unlikely — my roots are here","value":3},{"id":"d","text":"Never — this is dealbreaker territory","value":4}] },
  { "id": 93, "text": "How do you maintain friendship with your partner?", "emoji": "👫", "options": [{"id":"a","text":"Laugh together daily","value":1},{"id":"b","text":"Regular check-ins on how we're doing","value":2},{"id":"c","text":"Do things together outside of routine","value":3},{"id":"d","text":"Give each other the same care as a best friend","value":4}] },
  { "id": 94, "text": "What makes you feel the most secure in a relationship?", "emoji": "🛡️", "options": [{"id":"a","text":"Consistent actions over time","value":1},{"id":"b","text":"Open honest communication","value":2},{"id":"c","text":"Knowing they choose me every day","value":3},{"id":"d","text":"Shared plans for the future","value":4}] },
  { "id": 95, "text": "What's your philosophy on forgiveness?", "emoji": "🕊️", "options": [{"id":"a","text":"Forgive quickly — life is short","value":1},{"id":"b","text":"Forgive but take time to heal first","value":2},{"id":"c","text":"Depends on what was done","value":3},{"id":"d","text":"Some things can't be forgiven","value":4}] },
  { "id": 96, "text": "How do you recharge after a difficult week?", "emoji": "🔋", "options": [{"id":"a","text":"Cuddle up with partner, do nothing","value":1},{"id":"b","text":"Solo time — walk, bath, music","value":2},{"id":"c","text":"Social time with friends","value":3},{"id":"d","text":"Sleep, eat, repeat","value":4}] },
  { "id": 97, "text": "What do you value most in daily life together?", "emoji": "🌻", "options": [{"id":"a","text":"Peaceful routines and rituals","value":1},{"id":"b","text":"Spontaneity and surprise","value":2},{"id":"c","text":"Deep conversations","value":3},{"id":"d","text":"Laughter and lightness","value":4}] },
  { "id": 98, "text": "How do you envision growing old together?", "emoji": "👴👵", "options": [{"id":"a","text":"Adventure until the very end","value":1},{"id":"b","text":"Peaceful, surrounded by family","value":2},{"id":"c","text":"Still making each other laugh","value":3},{"id":"d","text":"Quietly, deeply, just us","value":4}] },
  { "id": 99, "text": "What's the most romantic thing a partner can do?", "emoji": "💫", "options": [{"id":"a","text":"Remember something small I mentioned months ago","value":1},{"id":"b","text":"Plan something just for me, no occasion needed","value":2},{"id":"c","text":"Choose me publicly and proudly","value":3},{"id":"d","text":"Make ordinary moments feel extraordinary","value":4}] }
]
